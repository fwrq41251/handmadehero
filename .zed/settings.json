{
  "languages": {
    "Zig": {
      "formatter": "language_server",
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll": false
      },
      "tab_size": 4,
      "hard_tabs": false
    }
  },
  "lsp": {
    "zls": {
      "binary": {
        "path": "mise",
        "arguments": ["exec", "--", "zls"]
      },
      "settings": {
        "zls": {
          "enable_build_on_save": true
        }
      }
    }
  }
}
